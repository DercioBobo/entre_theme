 "fields": [
  {
   "fieldname": "tab_general",
   "fieldtype": "Tab Break",
   "label": "Geral"
  },
  {
   "fieldname": "section_brand",
   "fieldtype": "Section Break",
   "label": "Marca"
  },
  {
   "fieldname": "logo_url",
   "fieldtype": "Attach Image",
   "label": "Logótipo",
   "description": "O logótipo principal: barra superior, página de login e marcas de água (quando não há outro definido)."
  },
  {
   "fieldname": "navbar_logo",
   "fieldtype": "Attach Image",
   "label": "Logótipo da Barra Superior",
   "description": "Só se quiser um logótipo diferente na barra superior (por exemplo, uma versão compacta). Vazio: usa o Logótipo, ou o do Frappe se também estiver vazio."
  },
  {
   "fieldname": "column_break_brand",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "favicon",
   "fieldtype": "Attach Image",
   "label": "Favicon",
   "description": "Ícone no separador do navegador (PNG quadrado ou ICO). Aplica-se ao sistema, à página de login e ao site."
  },
  {
   "fieldname": "tab_login",
   "fieldtype": "Tab Break",
   "label": "Página de Login"
  },
  {
   "fieldname": "section_login_style",
   "fieldtype": "Section Break",
   "label": "Estilo"
  },
  {
   "fieldname": "login_style",
   "fieldtype": "Select",
   "label": "Estilo da Página de Login",
   "options": "Clássico\nDividido\nPainel Lateral\nImersivo\nFoco\nMoldura\nCartão Duplo\nVívido\nVidro\nAurora\nTipográfico\nMinimalista\nNoite",
   "default": "Clássico",
   "description": "Clássico: cartão ao centro. Dividido: painel da marca de um lado. Painel Lateral: imagem com o formulário numa faixa. Imersivo: imagem inteira com boas-vindas em grande. Foco: logótipo ao centro e campos translúcidos. Moldura: moldura arredondada com imagem ou ilustração. Cartão Duplo: cartão dividido com formas geométricas. Vívido: duas cores. Vidro: cartão translúcido. Aurora: faixas de cor em movimento. Tipográfico: o nome da empresa em grande no fundo. Minimalista: sem cartão. Noite: escuro. As opções de cada estilo aparecem em baixo."
  },
  {
   "fieldname": "login_bg_url",
   "fieldtype": "Attach Image",
   "label": "Imagem de Fundo",
   "description": "Usada pelos estilos Clássico, Dividido, Painel Lateral e Vidro. Vazio: um fundo feito com a cor de destaque."
  },
  {
   "fieldname": "column_break_login_style",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "company_tagline",
   "fieldtype": "Data",
   "label": "Slogan",
   "description": "Na página de login; em destaque nos estilos Dividido e Painel Lateral."
  },
  {
   "fieldname": "section_login_hero",
   "fieldtype": "Section Break",
   "label": "Boas-vindas",
   "depends_on": "eval:[\"Imersivo\", \"Moldura\", \"Cartão Duplo\"].includes(doc.login_style)"
  },
  {
   "fieldname": "login_headline",
   "fieldtype": "Data",
   "label": "Título de Boas-vindas",
   "default": "Bem-vindo de volta",
   "description": "Imersivo e Cartão Duplo: em grande no painel. Moldura: o título do formulário."
  },
  {
   "fieldname": "column_break_login_hero",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "login_subtext",
   "fieldtype": "Small Text",
   "label": "Texto de Apoio",
   "default": "Entre com os seus dados para continuar a trabalhar.",
   "description": "Por baixo do título, nos estilos Imersivo e Cartão Duplo."
  },
  {
   "fieldname": "section_login_overlay",
   "fieldtype": "Section Break",
   "label": "Imagem e Película",
   "depends_on": "eval:[\"Clássico\", \"Dividido\", \"Painel Lateral\", \"Vidro\", \"Imersivo\", \"Foco\", \"Moldura\"].includes(doc.login_style)",
   "description": "Só quando há Imagem de Fundo."
  },
  {
   "fieldname": "login_overlay",
   "fieldtype": "Check",
   "label": "Aplicar Película sobre a Imagem",
   "default": "1",
   "description": "Uma camada de cor por cima da imagem, para o texto e o logótipo se lerem bem."
  },
  {
   "fieldname": "column_break_login_overlay",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "login_overlay_color",
   "fieldtype": "Color",
   "label": "Cor da Película",
   "description": "Vazio: a cor de destaque do login (escura nos estilos Imersivo e Foco).",
   "depends_on": "login_overlay"
  },
  {
   "fieldname": "login_overlay_opacity",
   "fieldtype": "Int",
   "label": "Intensidade da Película (%)",
   "default": "80",
   "description": "0 = transparente, 100 = cor sólida.",
   "depends_on": "login_overlay"
  },
  {
   "fieldname": "section_login_panel",
   "fieldtype": "Section Break",
   "label": "Painel e Disposição",
   "depends_on": "eval:[\"Dividido\", \"Painel Lateral\", \"Imersivo\", \"Moldura\", \"Cartão Duplo\"].includes(doc.login_style)"
  },
  {
   "fieldname": "login_panel_side",
   "fieldtype": "Select",
   "label": "Lado do Painel",
   "options": "Esquerda\nDireita",
   "default": "Esquerda",
   "description": "O lado do painel da marca, da imagem ou das boas-vindas. O formulário fica do lado oposto."
  },
  {
   "fieldname": "login_panel_width",
   "fieldtype": "Select",
   "label": "Largura do Painel",
   "options": "Estreito\nMédio\nLargo",
   "default": "Médio",
   "depends_on": "eval:[\"Dividido\", \"Painel Lateral\"].includes(doc.login_style)"
  },
  {
   "fieldname": "login_decoration",
   "fieldtype": "Select",
   "label": "Decoração",
   "options": "Anel\nPontos\nNenhuma",
   "default": "Anel",
   "depends_on": "eval:[\"Dividido\", \"Painel Lateral\"].includes(doc.login_style)"
  },
  {
   "fieldname": "login_panel_text",
   "fieldtype": "Color",
   "label": "Cor do Texto do Painel",
   "description": "Vazio: automática (Texto sobre a Cor Principal, ou branco sobre uma imagem sem película).",
   "depends_on": "eval:[\"Dividido\", \"Painel Lateral\", \"Imersivo\", \"Cartão Duplo\"].includes(doc.login_style)"
  },
  {
   "fieldname": "column_break_login_panel",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "login_panel_logo",
   "fieldtype": "Check",
   "label": "Mostrar Logótipo no Painel",
   "default": "1",
   "depends_on": "eval:[\"Dividido\", \"Painel Lateral\", \"Cartão Duplo\"].includes(doc.login_style)"
  },
  {
   "fieldname": "login_logo_plate",
